// ============================================================================
// Durian Hub - Prisma Database Schema v2 (PostgreSQL / MySQL Compatible)
// รองรับ:
// 1. ระบบ Login / สมัครสมาชิกเลือก 1 บทบาทหลัก + ยื่นเอกสารขอเพิ่มบทบาทที่ 2
// 2. ข้อมูลฤดูกาลทุเรียน 6 ภูมิภาคของไทย (Regional Seasons)
// 3. ตลาดกลาง 3 คอลัมน์ (โพสต์ขาย / โพสต์รับซื้อ / โพสต์รับตัด)
// 4. ระบบห้องแชทอ้างอิงโพสต์สินค้า + การ์ดสินค้าในแชท + ปุ่มข้อความด่วน
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum RoleType {
  SELLER // ผู้ขายทุเรียน / ชาวสวน
  BUYER  // ผู้ซื้อทุเรียน / ล้งรับซื้อ
  CUTTER // ผู้รับตัดทุเรียน / ทีมตัด
  ADMIN  // ผู้ดูแลระบบ
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum RoleStatus {
  ACTIVE
  PENDING_APPROVAL
  REJECTED
}

enum VerificationDocType {
  GAP_CERTIFICATE      // ใบรับรองมาตรฐาน GAP (สำหรับชาวสวน)
  FARMER_BOOK          // สมุดทะเบียนเกษตรกร (สำหรับชาวสวน)
  COMMERCIAL_LICENSE   // ทะเบียนพาณิชย์ / ทะเบียนล้ง (สำหรับผู้รับซื้อ)
  CUTTER_CERT_OR_PORT  // ใบผ่านการอบรมนักตัดทุเรียน หรือผลงานทีมตัด
  NATIONAL_ID_WITH_PIC // รูปถ่ายคู่บัตรประชาชนและสถานที่จริง
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PostType {
  SELL        // โพสต์ต้องการขาย (ชาวสวน)
  BUY         // โพสต์ต้องการซื้อ (ล้งรับซื้อ)
  CUT_SERVICE // โพสต์รับจ้างตัดทุเรียน (ทีมตัด)
}

enum PriceUnit {
  PER_KG   // บาทต่อกิโลกรัม
  PER_TON  // บาทต่อตัน
  LUMP_SUM // เหมาสวน / เหมางาน
}

enum PostStatus {
  OPEN
  CLOSED
  HIDDEN_BY_ADMIN
}

enum ChatRoomStatus {
  ACTIVE
  DEAL_CLOSED
  ARCHIVED
}

enum ChatMessageType {
  TEXT
  PRODUCT_CARD
  QUICK_REPLY
  IMAGE
}

enum ReportReason {
  FAKE_PRICE // จงใจปั่นราคา / กรอกราคาไม่ตรงความจริง
  SPAM       // โพสต์สแปม / ก่อกวน
  SCAM       // มิจฉาชีพ / หลอกลวง
  WRONG_INFO // ข้อมูลสายพันธุ์หรือพื้นที่ไม่ถูกต้อง
}

enum DealStatus {
  PENDING
  ACCEPTED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum OtpPurpose {
  VERIFY_EMAIL   // ยืนยันอีเมลหลังสมัครสมาชิก
  RESET_PASSWORD // ลืมรหัสผ่าน
}

// ----------------------------------------------------------------------------
// 1. ระบบสมาชิก บทบาท และการยื่นเอกสารขอเพิ่มบทบาท (Users & Roles)
// ----------------------------------------------------------------------------

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique // บังคับทุกคน — ใช้ส่ง OTP ยืนยันอีเมลและลืมรหัสผ่าน
  emailVerifiedAt DateTime? @map("email_verified_at") // null = ยังไม่ยืนยันอีเมล
  phone         String     @unique
  passwordHash  String     @map("password_hash")
  fullName      String     @map("full_name")
  avatarUrl     String?    @map("avatar_url")
  locationId    Int?       @map("location_id")
  activeRole    RoleType   @default(SELLER) @map("active_role")
  isKycVerified Boolean    @default(false) @map("is_kyc_verified")
  trustScore       Int        @default(100) @map("trust_score") // คะแนนความประพฤติสมาชิก (เริ่มต้น 100 เต็ม 100)
  ratingAvg        Decimal    @default(5.00) @db.Decimal(3, 2) @map("rating_avg")
  ratingCount      Int        @default(0) @map("rating_count")
  status           UserStatus @default(ACTIVE)
  suspendedUntil   DateTime?  @map("suspended_until")
  suspensionReason String?    @map("suspension_reason")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  location             Location?                 @relation(fields: [locationId], references: [id])
  roles                UserRole[]
  roleRequests         RoleVerificationRequest[] @relation("UserRoleRequests")
  reviewedRoleRequests RoleVerificationRequest[] @relation("AdminReviewedRequests")
  posts                MarketplacePost[]
  chatRoomsInitiated   ChatRoom[]                @relation("ChatInitiator")
  chatRoomsOwned       ChatRoom[]                @relation("ChatOwner")
  messagesSent         ChatMessage[]
  reportsMade          PostReport[]
  dealsInitiated       Deal[]                    @relation("DealInitiator")
  dealsReceived        Deal[]                    @relation("DealReceiver")
  reviewsGiven         UserReview[]              @relation("ReviewGiver")
  reviewsReceived      UserReview[]              @relation("ReviewReceiver")
  otpCodes             OtpCode[]
  supportTickets       SupportTicket[] @relation("SupportRequester")
  supportMessages      SupportMessage[]

  @@map("users")
}

// รหัส OTP ทางอีเมล (เก็บเฉพาะ hash ไม่เก็บเลขจริง)
model OtpCode {
  id        Int        @id @default(autoincrement())
  userId    Int        @map("user_id")
  purpose   OtpPurpose
  codeHash  String     @map("code_hash")
  attempts  Int        @default(0) // จำนวนครั้งที่กรอกผิด
  expiresAt DateTime   @map("expires_at")
  usedAt    DateTime?  @map("used_at")
  createdAt DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("otp_codes")
}

model UserRole {
  id            Int        @id @default(autoincrement())
  userId        Int        @map("user_id")
  roleType      RoleType   @map("role_type")
  isPrimaryRole Boolean    @default(false) @map("is_primary_role")
  businessName  String?    @map("business_name")
  licenseNumber String?    @map("license_number")
  description   String?    @db.Text
  status        RoleStatus @default(ACTIVE)
  isVerified    Boolean    @default(false) @map("is_verified")
  createdAt     DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleType])
  @@map("user_roles")
}

model RoleVerificationRequest {
  id                Int                 @id @default(autoincrement())
  userId            Int                 @map("user_id")
  requestedRole     RoleType            @map("requested_role")
  businessName      String              @map("business_name")
  licenseNumber     String?             @map("license_number") // เลขเอกสาร เป็นข้อความ ไม่ใช่ FK
  documentType      VerificationDocType @map("document_type")
  documentUrl       String              @map("document_url")
  note              String?             @db.Text
  status            RequestStatus       @default(PENDING)
  reviewedByAdminId Int?                @map("reviewed_by_admin_id")
  adminRemark       String?             @db.Text @map("admin_remark")
  createdAt         DateTime            @default(now()) @map("created_at")
  reviewedAt        DateTime?           @map("reviewed_at")

  user            User  @relation("UserRoleRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedByAdmin User? @relation("AdminReviewedRequests", fields: [reviewedByAdminId], references: [id])

  @@index([userId, status])
  @@map("role_verification_requests")
}

// ----------------------------------------------------------------------------
// 2. ข้อมูลฤดูกาลทุเรียนรายภูมิภาค (Regional Seasons - อ้างอิงรูปที่ 1)
// ----------------------------------------------------------------------------

model RegionalSeason {
  id               Int        @id @default(autoincrement())
  regionCode       String     @unique @map("region_code") // NORTH, CENTRAL, ISAN, EAST, SOUTH, DEEP_SOUTH
  regionName       String     @map("region_name")         // ภาคเหนือ, ภาคกลาง, ภาคอีสาน, ภาคตะวันออก, ภาคใต้, 3 จังหวัดชายแดนใต้
  provincesSummary String     @db.Text @map("provinces_summary")
  popularVarieties String     @map("popular_varieties")
  harvestPeriod    String     @map("harvest_period")      // เช่น เม.ย. - พ.ค., ก.พ. - มิ.ย.
  highlightNote    String?    @db.Text @map("highlight_note")
  locations        Location[]

  @@map("regional_seasons")
}

model Location {
  id               Int             @id @default(autoincrement())
  province         String
  district         String
  region           String
  regionalSeasonId Int?            @map("regional_season_id")
  regionalSeason   RegionalSeason? @relation(fields: [regionalSeasonId], references: [id])

  users       User[]
  posts       MarketplacePost[]
  marketStats DailyMarketStat[]

  @@unique([province, district])
  @@index([province])
  @@map("locations")
}

model DurianVariety {
  id          Int      @id @default(autoincrement())
  nameTh      String   @unique @map("name_th")
  nameEn      String   @map("name_en")
  iconEmoji   String?  @map("icon_emoji")
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")

  posts       MarketplacePost[]
  marketStats DailyMarketStat[]

  @@map("durian_varieties")
}

model DurianGrade {
  id          Int     @id @default(autoincrement())
  gradeCode   String  @unique @map("grade_code")
  nameTh      String  @map("name_th")
  description String? @db.Text

  posts       MarketplacePost[]
  marketStats DailyMarketStat[]

  @@map("durian_grades")
}

// ----------------------------------------------------------------------------
// 3. ระบบโพสต์ตลาดกลาง 3 คอลัมน์ (Marketplace Posts - อ้างอิงรูปที่ 2 และ 3)
// ----------------------------------------------------------------------------

model MarketplacePost {
  id             Int        @id @default(autoincrement())
  userId         Int        @map("user_id")
  postType       PostType   @map("post_type") // SELL, BUY, CUT_SERVICE
  varietyId      Int?       @map("variety_id")
  gradeId        Int?       @map("grade_id")
  locationId     Int        @map("location_id")
  title          String
  content        String     @db.Text
  price          Decimal    @db.Decimal(10, 2) @map("price") // ราคากลาง/ราคาเสนอ (รองรับ บาท/กก., บาท/ตัน หรือราคาเหมาแปลง)
  pricePerKg     Decimal?   @db.Decimal(10, 2) @map("price_per_kg") // ราคาต่อ กก. (optional สำหรับกรณีเหมางานบริการตัด)
  priceUnit      PriceUnit  @default(PER_KG) @map("price_unit")
  quantityKg     Decimal?   @db.Decimal(12, 2) @map("quantity_kg")
  dryMatterPct   Decimal?   @db.Decimal(4, 1) @map("dry_matter_pct")
  availableDate  DateTime   @db.Date @map("available_date")
  isPriceOutlier Boolean    @default(false) @map("is_price_outlier")
  reportCount    Int        @default(0) @map("report_count")
  viewCount      Int        @default(0) @map("view_count")
  status         PostStatus @default(OPEN)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variety   DurianVariety? @relation(fields: [varietyId], references: [id])
  grade     DurianGrade?   @relation(fields: [gradeId], references: [id])
  location  Location       @relation(fields: [locationId], references: [id])
  images    PostImage[]
  chatRooms ChatRoom[]
  reports   PostReport[]
  deals     Deal[]

  @@index([postType, varietyId, gradeId, createdAt])
  @@index([locationId, status])
  @@map("marketplace_posts")
}

model PostImage {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  post MarketplacePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_images")
}

// ----------------------------------------------------------------------------
// 4. ระบบห้องแชทซื้อขายอ้างอิงโพสต์ (Chat System - อ้างอิงรูปที่ 4 และ 5)
// ----------------------------------------------------------------------------

model ChatRoom {
  id            Int            @id @default(autoincrement())
  postId        Int            @map("post_id")
  initiatorId   Int            @map("initiator_id") // ผู้กดปุ่ม "ซื้อสินค้า / ทักแชท"
  ownerId       Int            @map("owner_id")     // เจ้าของโพสต์
  status        ChatRoomStatus @default(ACTIVE)
  lastMessageAt DateTime       @default(now()) @map("last_message_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  closedAt      DateTime?      @map("closed_at")

  post      MarketplacePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  initiator User            @relation("ChatInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  owner     User            @relation("ChatOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  supportTickets SupportTicket[]

  @@unique([postId, initiatorId])
  @@index([initiatorId, lastMessageAt])
  @@index([ownerId, lastMessageAt])
  @@map("chat_rooms")
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model SupportTicket {
  id Int @id @default(autoincrement())
  roomId Int @map("room_id")
  requesterId Int @map("requester_id")
  category String @db.VarChar(50)
  status SupportStatus @default(OPEN)
  resolution String? @db.Text
  handledById Int? @map("handled_by_id")
  queuedAt DateTime @default(now()) @map("queued_at")
  resolvedAt DateTime? @map("resolved_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  requester User @relation("SupportRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  messages SupportMessage[]
  @@unique([roomId, requesterId])
  @@index([status, updatedAt])
  @@index([status, queuedAt, id])
  @@map("support_tickets")
}

model SupportMessage {
  id Int @id @default(autoincrement())
  ticketId Int @map("ticket_id")
  senderId Int @map("sender_id")
  isAdmin Boolean @default(false) @map("is_admin")
  content String @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  sender User @relation(fields: [senderId], references: [id], onDelete: Restrict)
  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model ChatMessage {
  id          Int             @id @default(autoincrement())
  roomId      Int             @map("room_id")
  senderId    Int             @map("sender_id")
  messageType ChatMessageType @default(TEXT) @map("message_type")
  content     String          @db.Text
  isRead      Boolean         @default(false) @map("is_read")
  createdAt   DateTime        @default(now()) @map("created_at")

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

// ----------------------------------------------------------------------------
// 5. ระบบวิเคราะห์ราคากลางและกราฟแดชบอร์ด (Market Price Analytics)
// ----------------------------------------------------------------------------

model DailyMarketStat {
  id                Int      @id @default(autoincrement())
  statDate          DateTime @db.Date @map("stat_date")
  varietyId         Int      @map("variety_id")
  gradeId           Int      @map("grade_id")
  locationId        Int      @map("location_id")
  avgBuyPrice       Decimal? @db.Decimal(10, 2) @map("avg_buy_price")
  avgSellPrice      Decimal? @db.Decimal(10, 2) @map("avg_sell_price")
  minPrice          Decimal? @db.Decimal(10, 2) @map("min_price")
  maxPrice          Decimal? @db.Decimal(10, 2) @map("max_price")
  avgCutWagePerKg   Decimal? @db.Decimal(10, 2) @map("avg_cut_wage_per_kg")
  officialRefPrice  Decimal? @db.Decimal(10, 2) @map("official_ref_price")
  totalBuyVolumeKg  Decimal  @default(0) @db.Decimal(14, 2) @map("total_buy_volume_kg")
  totalSellVolumeKg Decimal  @default(0) @db.Decimal(14, 2) @map("total_sell_volume_kg")
  samplePostCount   Int      @default(0) @map("sample_post_count")
  updatedAt         DateTime @updatedAt @map("updated_at")

  variety  DurianVariety @relation(fields: [varietyId], references: [id])
  grade    DurianGrade   @relation(fields: [gradeId], references: [id])
  location Location      @relation(fields: [locationId], references: [id])

  @@unique([statDate, varietyId, gradeId, locationId])
  @@index([statDate, varietyId])
  @@map("daily_market_stats")
}

// ----------------------------------------------------------------------------
// 6. ระบบรายงานโพสต์ ดีลซื้อขาย และรีวิวคู่ค้า (Trust & Dispute Management)
// ----------------------------------------------------------------------------

model PostReport {
  id         Int           @id @default(autoincrement())
  postId     Int           @map("post_id")
  reporterId Int           @map("reporter_id")
  reason     ReportReason
  detail     String?       @db.Text
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now()) @map("created_at")

  post     MarketplacePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User            @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("post_reports")
}

model Deal {
  id               Int        @id @default(autoincrement())
  postId           Int        @map("post_id")
  initiatorId      Int        @map("initiator_id")
  receiverId       Int        @map("receiver_id")
  agreedPrice      Decimal    @db.Decimal(10, 2) @map("agreed_price") // ราคาที่ตกลง (รองรับทั้งต่อ กก. หรือเหมางาน)
  agreedPricePerKg Decimal?   @db.Decimal(10, 2) @map("agreed_price_per_kg") // ราคาต่อ กก. (ถ้ามี)
  agreedQuantityKg Decimal?   @db.Decimal(12, 2) @map("agreed_quantity_kg")
  cutDate          DateTime?  @db.Date @map("cut_date")
  note             String?    @db.Text
  status           DealStatus @default(PENDING)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  post      MarketplacePost @relation(fields: [postId], references: [id])
  initiator User            @relation("DealInitiator", fields: [initiatorId], references: [id])
  receiver  User            @relation("DealReceiver", fields: [receiverId], references: [id])
  reviews   UserReview[]

  @@map("deals")
}

model UserReview {
  id         Int      @id @default(autoincrement())
  dealId     Int      @map("deal_id")
  reviewerId Int      @map("reviewer_id")
  revieweeId Int      @map("reviewee_id")
  rating     Int // MySQL CHECK 1..5: database/hardening.sql; participant checks in reviews API
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  deal     Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  reviewer User @relation("ReviewGiver", fields: [reviewerId], references: [id])
  reviewee User @relation("ReviewReceiver", fields: [revieweeId], references: [id])

  @@unique([dealId, reviewerId])
  @@map("user_reviews")
}
