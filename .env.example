# -----------------------------------------------------------------------------
# DURIAN HUB - Environment Variables Example
# คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าตามการใช้งาน
# -----------------------------------------------------------------------------

# 1. การเชื่อมต่อฐานข้อมูล MySQL (Docker ใช้พอร์ต 3306 ภายใน / เครื่องคอมพิวเตอร์ทั่วไปชี้ 3307)
# สำหรับรัน Local ทั่วไป:
DATABASE_URL="mysql://root:password@localhost:3307/durian_hub"
# สำหรับรันใน Docker container:
# DATABASE_URL="mysql://root:password@mysql:3306/durian_hub"

# 2. JWT Session Security Secret (คีย์สุ่มสำหรับเข้ารหัส Token)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# 3. การตั้งค่าระบบส่งอีเมล OTP (Mailpit สำหรับ Local Development)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Durian Hub <no-reply@durianhub.local>"

# 4. ที่อยู่หน้าเว็บหลัก
NEXT_PUBLIC_APP_URL="http://localhost:3000"

