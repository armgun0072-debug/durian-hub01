    REVIEW --> TOTAL
    TOTAL --> Z_TOTAL
    CLOSED -->|เมื่อครบกำหนด| HISTORY
    R_REQUEST --> REQUEST
    REQUEST --> ROLEADMIN
    B_ROLE --> ROLEADMIN
    ROLEADMIN -->|อนุมัติ| GRANT
    ROLEADMIN -->|ปฏิเสธ| REJECT
    GRANT --> A_GRANT
    REJECT --> Z_REJECT
    C_REPORT --> REPORT
    REPORT --> MOD
    B_MOD --> MOD
    MOD --> MOD_RESULT
    MOD_RESULT -->|พบ| PENALTY
    MOD_RESULT -->|ไม่พบ| DISMISS
    PENALTY --> Z_PENALTY
    DISMISS --> Z_DISMISS
    HISTORY -.->|ขอความช่วยเหลือ| H_SUPPORT
