Table users {
  id integer [pk, increment, not null]
  email varchar(191) [not null]
  email_verified_at datetime(3)
  phone varchar(191) [not null]
  password_hash varchar(191) [not null]
  full_name varchar(191) [not null]
  avatar_url varchar(191)
  location_id integer
  active_role users_active_role_enum [not null, default: 'SELLER']
  is_kyc_verified boolean [not null, default: false]
  trust_score integer [not null, default: 100]
  rating_avg decimal(3, 2) [not null, default: 5.00]
  rating_count integer [not null, default: 0]
  status users_status_enum [not null, default: 'ACTIVE']
  suspended_until datetime(3)
  suspension_reason varchar(191)
  created_at datetime(3) [not null, default: `CURRENT_TIMESTAMP(3)`]
  updated_at datetime(3) [not null]

  indexes {
    (email) [name: 'users_email_key', unique]
    (phone) [name: 'users_phone_key', unique]
  }
}

